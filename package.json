{
  "name": "dikgang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup:db": "node --env-file .env.local scripts/setup-db.mjs",
    "seed:holidays": "node --env-file .env.local scripts/seed-holidays.mjs",
    "embed": "node --env-file .env.local scripts/embed-chunks.mjs",
    "ingest": "node --env-file .env.local scripts/ingest.mjs",
    "pipeline": "node --env-file .env.local scripts/pipeline.mjs",
    "watch": "node --env-file .env.local scripts/watcher.mjs",
    "backfill-toc": "node --env-file .env.local scripts/backfill-toc.mjs",
    "mail:fetch": "node --env-file .env.local scripts/mail-fetch.mjs",
    "inspect:pdfs": "python3 scripts/inspect_pdfs.py",
    "raganything:setup": "python3 -m venv scripts/raganything-ingest/.venv && scripts/raganything-ingest/.venv/bin/pip install -r scripts/raganything-ingest/requirements.txt",
    "ingest:raganything:test": "scripts/raganything-ingest/.venv/bin/python scripts/raganything-ingest/ingest.py --limit 2 --max-pages 3 --page-batch-size 3 --output data/raganything/dailynews-elements-test.json",
    "ingest:raganything": "scripts/raganything-ingest/.venv/bin/python scripts/raganything-ingest/ingest.py --output data/raganything/dailynews-elements.json",
    "import:raganything": "node --env-file .env.local scripts/import-raganything-elements.mjs data/raganything/dailynews-elements-test.json",
    "embed:elements": "node --env-file .env.local scripts/embed-elements.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@types/pg": "latest",
    "date-holidays": "^3.30.2",
    "httpntlm": "^1.8.13",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
