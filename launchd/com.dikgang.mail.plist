<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Polls the Exchange inbox every hour for new newspaper attachments.
       Credentials live in ~/.config/dikgang/mail.env, not here. -->
  <key>Label</key>
  <string>com.dikgang.mail</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mandersonk/code/javaScript/dailynews/launchd/mail-fetch.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/mandersonk/Library/Logs/dikgang-mail.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mandersonk/Library/Logs/dikgang-mail.log</string>
</dict>
</plist>
